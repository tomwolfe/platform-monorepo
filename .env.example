# ═══════════════════════════════════════════════════════════════════
# APPS MONOREPO - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development
# Run: cp .env.example .env.local
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# DATABASE
# ───────────────────────────────────────────────────────────────────
# Local: postgresql://apps:apps@localhost:5432/apps
# Production: Your managed database URL
DATABASE_URL=

# ───────────────────────────────────────────────────────────────────
# REDIS (Upstash Redis or Local)
# ───────────────────────────────────────────────────────────────────
# Local: http://localhost:6379 (password: apps)
# Production: Your Upstash Redis URL
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───────────────────────────────────────────────────────────────────
# QSTASH (Upstash QStash for Saga Execution)
# ───────────────────────────────────────────────────────────────────
# Get from: https://console.upstash.io/qstash
# Local: http://localhost:6380 (Redis Streams emulator)
QSTASH_URL=
QSTASH_TOKEN=
UPSTASH_QSTASH_TOKEN=
# Signing keys for webhook verification (from QStash Console > Keys)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ───────────────────────────────────────────────────────────────────
# ABLY (Realtime Mesh)
# ───────────────────────────────────────────────────────────────────
# Local: local:appkey (Ably emulator)
# Production: Your Ably API key
ABLY_API_KEY=

# ───────────────────────────────────────────────────────────────────
# CLERK (Authentication)
# ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com > API Keys
# Use test keys for local development
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ───────────────────────────────────────────────────────────────────
# RESEND (Email)
# ───────────────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
# Use test key for local development
RESEND_API_KEY=

# ───────────────────────────────────────────────────────────────────
# LLM CONFIGURATION (Z.ai GLM)
# ───────────────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.7-flash

# ───────────────────────────────────────────────────────────────────
# HUGGINGFACE (Semantic Memory Embeddings)
# ───────────────────────────────────────────────────────────────────
# Get from: https://huggingface.co/settings/tokens
# Model: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL_URL=https://api-inference.huggingface.co/models/sentence-transformers/all-MiniLM-L6-v2

# ───────────────────────────────────────────────────────────────────
# UPSTASH VECTOR (Production Semantic Memory)
# ───────────────────────────────────────────────────────────────────
# Optional: If not set, falls back to Redis brute-force search
# Get from: https://console.upstash.io/vector
UPSTASH_VECTOR_URL=
UPSTASH_VECTOR_TOKEN=
UPSTASH_VECTOR_INDEX_PREFIX=

# ───────────────────────────────────────────────────────────────────
# WEB3 / CRYPTO PAYMENT CONFIGURATION
# ───────────────────────────────────────────────────────────────────
# Payment mode: DIRECT_P2P (TableStack default), ESCROW (Open-Delivery), or DISABLED
# - DIRECT_P2P: Payments go directly to merchant/restaurant wallet
# - ESCROW: Payments go through non-custodial escrow smart contract
# - DISABLED: Web3 payments disabled; use traditional payment methods
PAYMENT_MODE=DIRECT_P2P

# Non-custodial escrow contract address (deployed P2P escrow)
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=

# Escrow resolver private key (backend key for release() only)
# NEVER expose this in frontend code
ESCROW_RESOLVER_PRIVATE_KEY=

# Platform fee wallet address (receives platform fees directly from escrow)
NEXT_PUBLIC_PLATFORM_FEE_WALLET=

# Blockchain RPC URLs for transaction verification
# Get from: https://www.alchemy.com/ or https://infura.io/
# CRITICAL: In production, you MUST set these environment variables.
# Public fallback URLs (e.g., https://mainnet.base.org) are rate-limited and unreliable.
# Development only: Falls back to public URLs if not set (NOT FOR PRODUCTION).
BASE_RPC_URL=
POLYGON_RPC_URL=
ETHEREUM_RPC_URL=

# Client-side RPC URLs (exposed to browser, safe to use public fallbacks)
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_POLYGON_RPC_URL=
NEXT_PUBLIC_ETH_RPC_URL=

# Supported payment tokens (comma-separated)
NEXT_PUBLIC_SUPPORTED_TOKENS=USDC,ETH

# Token contract addresses
# USDC on Base: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# USDC on Polygon: 0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=

# Minimum confirmation blocks (Base: 3, Polygon: 128, Ethereum: 12)
NEXT_PUBLIC_MIN_CONFIRMATIONS=3

# ───────────────────────────────────────────────────────────────────
# PAYMENTS (Stripe) - For OpenDeliver delivery payments
# ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/test/apikeys
PAYMENT_MODE=off_platform
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ───────────────────────────────────────────────────────────────────
# PLATFORM / FEES
# ───────────────────────────────────────────────────────────────────
# Platform fee in basis points (default: 100 = 1%)
PLATFORM_FEE_BPS=
# Driver base pay in cents (default: 200 = $2.00)
DRIVER_BASE_PAY_CENTS=
# Web3 slippage tolerance in basis points (default: 200 = 2%)
SLIPPAGE_BPS=

# ───────────────────────────────────────────────────────────────────
# ROUTING / MOBILITY (100% Free)
# ───────────────────────────────────────────────────────────────────
# OpenRouteService API key (free tier: ~2,500 requests/day)
# Get free key at: https://openrouteservice.org/sign-up
# Fallback chain: ORS → Public OSRM → Haversine (offline)
OPENROUTESERVICE_API_KEY=
# ORS request timeout in ms (default: 5000)
ORS_ROUTING_TIMEOUT_MS=

# ───────────────────────────────────────────────────────────────────
# INTER-SERVICE COMMUNICATION
# ───────────────────────────────────────────────────────────────────
INTENTION_ENGINE_WEBHOOK_URL=http://localhost:3000/api/webhooks
OPENDELIVER_API_URL=http://localhost:3001/api
OPENDELIVER_WEBHOOK_URL=http://localhost:3001/api/webhooks
TABLESTACK_API_URL=http://localhost:3002/api/v1
TABLESTACK_MCP_URL=http://localhost:3002/api/mcp
OPENDELIVER_MCP_URL=http://localhost:3001/api/mcp
INTENTION_ENGINE_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───────────────────────────────────────────────────────────────────
# INTERNAL SYSTEM SECURITY
# ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SYSTEM_KEY=
INTERNAL_SERVICE_TOKEN=

# ───────────────────────────────────────────────────────────────────
# ADDITIONAL SECURITY
# ───────────────────────────────────────────────────────────────────
# CSRF protection secret (min 16 chars)
CSRF_SECRET=
# Treasury / AWS KMS for key management (optional)
TREASURY_KMS_KEY_ID=
TREASURY_KEYSTORE_JSON=
TREASURY_PASSPHRASE=
TREASURY_PRIVATE_KEY=
AWS_REGION=

# ───────────────────────────────────────────────────────────────────
# CRON JOBS
# ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ───────────────────────────────────────────────────────────────────
# OPENTELEMETRY (Observability)
# ───────────────────────────────────────────────────────────────────
# Local: http://localhost:4317 (Tempo via Docker)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=apps-monorepo
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# ───────────────────────────────────────────────────────────────────
# SENTRY (Error Tracking)
# ───────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_RELEASE=

# ───────────────────────────────────────────────────────────────────
# COMMUNICATION SERVICES (Optional)
# ───────────────────────────────────────────────────────────────────
# Twilio for SMS/Voice notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Email configuration
EMAIL_FROM=
ALERT_EMAIL=

# ───────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ───────────────────────────────────────────────────────────────────
# Set to true for local development with emulators
USE_LOCAL_REDIS=
USE_LOCAL_POSTGRES=
USE_LOCAL_QSTASH=
USE_LOCAL_ABLY=
USE_LOCAL_OTEL=

# ───────────────────────────────────────────────────────────────────
# AI / EXTERNAL SERVICES (Optional)
# ───────────────────────────────────────────────────────────────────
# MCP Server URLs for external tools
GITHUB_MCP_URL=
BRAVE_SEARCH_MCP_URL=
VERCEL_MCP_URL=
# Search APIs
TAVILY_API_KEY=
SERPER_API_KEY=
# LLM fallback model
LLM_FALLBACK_MODEL=

# ───────────────────────────────────────────────────────────────────
# RATE LIMITING
# ───────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# ───────────────────────────────────────────────────────────────────
# CLUSTER ENV
# ───────────────────────────────────────────────────────────────────
# Set to 'true' if running in Docker/K8s
CLUSTER_ENV=false
